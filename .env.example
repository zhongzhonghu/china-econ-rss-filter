# LLM API Keys (fill in at least one to enable LLM classification)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Provider: openai | anthropic
LLM_PROVIDER=anthropic

# Model name
# Cheap options: claude-haiku-4-5-20251001 (Anthropic) or gpt-4o-mini (OpenAI)
LLM_MODEL=claude-haiku-4-5-20251001

# Max articles to process per run (affects LLM cost)
MAX_ARTICLES_PER_RUN=200

# Max characters of article text sent to LLM
MAX_ARTICLE_CHARS_FOR_LLM=12000

# SQLite database path (relative to project root)
DATABASE_PATH=data/articles.sqlite

# GitHub Pages base URL (optional, used in feed metadata)
# Example: https://zhongzhonghu.github.io/china-econ-rss-filter
PUBLIC_FEED_BASE_URL=
